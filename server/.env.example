# Healthcare Report Explainer - Environment Variables
# Copy this file to .env and fill in your values

# Google Gemini API Key (Required)
# Get your key from: https://aistudio.google.com/apikey
# Gemini is used for ALL AI operations: vision (images/PDFs), text extraction, and analysis
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# File Upload Limits
MAX_FILE_SIZE_MB=10
MAX_PAGES_PER_REPORT=10

# Optional: Secondary AI Providers for enhanced features
GROQ_API_KEY=your_groq_api_key_here
OXLO_API_KEY=your_oxlo_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here

# Cache Settings
CACHE_TTL_SECONDS=3600

