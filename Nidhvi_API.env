# Nidhvi_API - Render Environment Variables
# Upload this file as a "Secret File" in Render, or paste these into the "Environment Variables" section

# --- REQUIRED API KEYS ---

# Google Gemini API Key (Required)
# Used for ALL AI operations: vision, text extraction, analysis, web research
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Required for complex medical analysis and Q&A)
GROQ_API_KEY=your_groq_api_key_here

# Oxlo API Key (Required for advanced OCR of scanned documents)
OXLO_API_KEY=your_oxlo_api_key_here

# Sarvam API Key (Required for Indian language translation and voice)
SARVAM_API_KEY=your_sarvam_api_key_here


# --- RENDER CONFIGURATION (DO NOT CHANGE) ---
NODE_ENV=production
# Render automatically sets PORT, so we don't need to define it here

# File Upload Limits
MAX_FILE_SIZE_MB=10
MAX_PAGES_PER_REPORT=10
