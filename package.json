{
    "name": "healthcare-report-explainer",
    "version": "1.0.0",
    "scripts": {
        "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"npm --prefix server run dev\" \"npm --prefix client start\"",
        "dev:server": "npm --prefix server run dev",
        "dev:client": "npm --prefix client start",
        "start": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"npm --prefix server start\" \"npm --prefix client start\"",
        "server": "npm --prefix server start",
        "client": "npm --prefix client start",
        "install:all": "npm install && npm --prefix server install && npm --prefix client install",
        "build": "npm --prefix client run build"
    },
    "devDependencies": {
        "concurrently": "^10.0.5"
    },
    "dependencies": {
        "@google/generative-ai": "^0.21.0",
        "axios": "^1.13.2",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "form-data": "^4.0.6",
        "helmet": "^7.1.0",
        "multer": "^1.4.5-lts.1",
        "openai": "^6.25.0",
        "pdf-parse": "^1.1.4",
        "uuid": "^9.0.0"
    }
}
